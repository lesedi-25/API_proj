@model RaceDay.Web.ViewModels.CreateResultViewModel

@{
    ViewData["Title"] = "Record Participant Result";
    var enrolments = ViewBag.Enrolments as List<RaceDay.Web.ViewModels.EnrolmentApiViewModel>;
}

<div class="container mt-4">

    <h2>Record Participant Result</h2>
    <p class="text-muted">Enter the finishing details for a participant.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-controller="Organiser"
          asp-action="CreateResult"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="EnrolmentId" class="form-label">
                Participant Enrolment
            </label>

            <select asp-for="EnrolmentId" class="form-select" required>
                <option value="">-- Select an enrolment --</option>

                @if (enrolments != null)
                {
                    foreach (var enrolment in enrolments)
                    {
                        <option value="@enrolment.EnrolmentId">
                            Enrolment #@enrolment.EnrolmentId
                            - Participant #@enrolment.ParticipantId
                            - Event #@enrolment.EventId
                        </option>
                    }
                }
            </select>

            <span asp-validation-for="EnrolmentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time
            </label>
            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="FinishTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Finishing Position
            </label>
            <input asp-for="Position"
                   type="number"
                   min="1"
                   class="form-control"
                   placeholder="Example: 1" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">
                Result Status
            </label>

            <select asp-for="Status" class="form-select">
                <option value="Finished">Finished</option>
                <option value="DidNotFinish">Did Not Finish</option>
                <option value="Disqualified">Disqualified</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Save Result
        </button>

        <a asp-controller="Organiser"
           asp-action="Results"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>