@model List<RaceDay.Web.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var events = ViewBag.Events as List<RaceDay.Web.ViewModels.EventViewModel>
                 ?? new List<RaceDay.Web.ViewModels.EventViewModel>();
}

<div class="container mt-4">

    <h2>Manage Event Categories</h2>
    <p class="text-muted">Create and manage categories for your events.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4>Create New Category</h4>

            @if (events.Any())
            {
                <form asp-controller="Organiser"
                      asp-action="CreateCategory"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Select Event</label>
                        <select name="EventId" class="form-select" required>
                            <option value="">-- Choose an event --</option>

                            @foreach (var item in events)
                            {
                                <option value="@item.EventId">
                                    @item.EventName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input name="CategoryName"
                               class="form-control"
                               maxlength="100"
                               required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Minimum Age</label>
                            <input name="MinimumAge"
                                   type="number"
                                   min="0"
                                   max="120"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Maximum Age</label>
                            <input name="MaximumAge"
                                   type="number"
                                   min="0"
                                   max="120"
                                   class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description"
                              class="form-control"
                              rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Create Category
                    </button>

                </form>
            }
            else
            {
                <p>You need to create an event before adding categories.</p>
            }

        </div>
    </div>

    <h4>Your Existing Categories</h4>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Event ID</th>
                        <th>Minimum Age</th>
                        <th>Maximum Age</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.EventId</td>
                            <td>@(category.MinimumAge?.ToString() ?? "Any")</td>
                            <td>@(category.MaximumAge?.ToString() ?? "Any")</td>
                            <td>@category.Description</td>
                            <td>
                                <a asp-controller="Organiser"
                                   asp-action="EditCategory"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-primary btn-sm">
                                    Edit
                                </a>
                                <form asp-controller="Organiser"
                                      asp-action="DeleteCategory"
                                      asp-route-id="@category.CategoryId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>
