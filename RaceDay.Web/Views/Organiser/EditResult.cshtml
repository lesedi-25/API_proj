@model RaceDay.Web.ViewModels.EditResultViewModel

@{
    ViewData["Title"] = "Edit Result";
}

<div class="container mt-4">

    <h2>Edit Participant Result</h2>
    <p class="text-muted">Correct the participant's finishing details.</p>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-controller="Organiser"
          asp-action="EditResult"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ResultId" />
        <input type="hidden" asp-for="EnrolmentId" />

        <div class="mb-3">
            <label class="form-label">Enrolment ID</label>
            <input value="@Model.EnrolmentId"
                   class="form-control"
                   readonly />
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">Finish Time</label>
            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="FinishTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">Finishing Position</label>
            <input asp-for="Position"
                   type="number"
                   min="1"
                   class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Result Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Finished">Finished</option>
                <option value="DidNotFinish">Did Not Finish</option>
                <option value="Disqualified">Disqualified</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Save Changes
        </button>

        <a asp-controller="Organiser"
           asp-action="Results"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
