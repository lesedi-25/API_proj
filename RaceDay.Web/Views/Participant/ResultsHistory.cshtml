@model List<RaceDay.Web.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "Race Results History";
}

<div class="container mt-5">

    <h1>My Race Results</h1>
    <p class="text-muted">
        View your previous race performances and finishing positions.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You do not have any race results yet.
            Results will appear here once they have been recorded.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered shadow-sm">

                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ResultId</td>
                            <td>@item.EnrolmentId</td>

                            <td>
                                @(item.FinishTime?.ToString(@"hh\:mm\:ss") ?? "N/A")
                            </td>

                            <td>
                                @(item.Position?.ToString() ?? "N/A")
                            </td>

                            <td>
                                @if (item.Status == "Finished")
                                {
                                    <span class="badge bg-success">Finished</span>
                                }
                                else if (item.Status == "DidNotFinish")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Did Not Finish
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @item.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-action="Index" class="btn btn-primary mt-3">
        Back to Dashboard
    </a>

</div>
