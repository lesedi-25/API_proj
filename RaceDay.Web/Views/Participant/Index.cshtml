@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">

    <h1>Welcome to RaceDay!</h1>

    <p>
        Hello, @Context.Session.GetString("FirstName").
    </p>

    <div class="mb-4">
        <a asp-controller="Participant"
           asp-action="MyEnrolments"
           class="btn btn-success">
            <i class="bi bi-calendar-check"></i> My Enrolments
        </a>
        <a asp-controller="Participant"
           asp-action="Profile"
           class="btn btn-primary ms-2">
            <i class="bi bi-person-circle"></i> My Profile
        </a>
        <a asp-controller="Participant"
           asp-action="ResultsHistory"
           class="btn btn-info ms-2">
            <i class="bi bi-trophy"></i> My Results
        </a>
    </div>

    <hr />

    <h2 class="mb-4">Upcoming Events</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            <!-- Event Type Filter -->
            <form asp-controller="Participant"
                  asp-action="Index"
                  method="get"
                  class="row g-2 mb-4">

                <div class="col-md-4">
                    <select name="eventType" class="form-select">
                        <option value="All">All Events</option>

                        <option value="Run"
                                selected="@(ViewBag.SelectedEventType == "Run")">
                            Running
                        </option>

                        <option value="Walk"
                                selected="@(ViewBag.SelectedEventType == "Walk")">
                            Walking
                        </option>

                        <option value="Cycle"
                                selected="@(ViewBag.SelectedEventType == "Cycle")">
                            Cycling
                        </option>
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-success">
                        Filter Events
                    </button>
                </div>
            </form>

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow h-100">

                        @if (!string.IsNullOrEmpty(item.EventBannerPath))
                        {
                            <img src="@item.EventBannerPath"
                                 class="card-img-top"
                                 alt="@item.EventName banner"
                                 style="height:200px; object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p>@item.Description</p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.DistanceKm km
                            </p>

                            <p>
                                <strong>Type:</strong>
                                @item.EventType
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @item.EntryFee.ToString("0.00")
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
