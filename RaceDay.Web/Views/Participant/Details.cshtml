@model RaceDay.Web.ViewModels.EventViewModel

@{
    ViewData["Title"] = "Event Details";

    var categories = ViewBag.Categories as
        List<RaceDay.Web.ViewModels.CategoryViewModel>
        ?? new List<RaceDay.Web.ViewModels.CategoryViewModel>();
}

<div class="container mt-5">

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        Back to Events
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow">

        @if (!string.IsNullOrEmpty(Model.EventBannerPath))
        {
            <img src="@Model.EventBannerPath"
                 class="card-img-top"
                 alt="@Model.EventName banner"
                 style="max-height:350px; width:100%; object-fit:cover;" />
        }

        <div class="card-body p-4">

            <h1 class="mb-3">@Model.EventName</h1>

            <p>@Model.Description</p>

            <hr />

            <h4>Event Information</h4>

            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Distance:</strong> @Model.DistanceKm km</p>
            <p><strong>Event Type:</strong> @Model.EventType</p>
            <p><strong>Entry Fee:</strong> R @Model.EntryFee.ToString("0.00")</p>

            <hr />

            <h4>Available Categories</h4>

            @if (categories.Count == 0)
            {
                <div class="alert alert-info">
                    No categories are currently available for this event.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var category in categories)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5>@category.CategoryName</h5>
                                    <p>@category.Description</p>

                                    <p>
                                        <strong>Minimum Age:</strong>
                                        @(category.MinimumAge?.ToString() ?? "No minimum")
                                    </p>

                                    <p>
                                        <strong>Maximum Age:</strong>
                                        @(category.MaximumAge?.ToString() ?? "No maximum")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <h4>Enrol in this Event</h4>

                <form asp-controller="Participant"
                      asp-action="Enrol"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="EventId"
                           value="@Model.EventId" />

                    <div class="mb-3">
                        <label for="CategoryId" class="form-label">
                            Select your category
                        </label>

                        <select name="CategoryId"
                                id="CategoryId"
                                class="form-select"
                                required>

                            <option value="">-- Choose a category --</option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.CategoryName
                                </option>
                            }

                        </select>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Enrol Now
                    </button>
                </form>
            }

        </div>
    </div>
</div>
